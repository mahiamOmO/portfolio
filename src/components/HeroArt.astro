---
const S = 2.4
const C = 0.866
const P = (x: number, y: number, z: number): [number, number] => [(x - y) * C * S, (x + y) * 0.5 * S - z * S]

const mix = (hex: string, k: number) => {
  const n = parseInt(hex.slice(1), 16)
  const r = Math.round(((n >> 16) & 255) * k)
  const g = Math.round(((n >> 8) & 255) * k)
  const b = Math.round((n & 255) * k)
  return `rgb(${r}, ${g}, ${b})`
}

type Poly = { pts: [number, number][]; fill: string }
const polys: Poly[] = []
const all: [number, number][] = []

const poly = (pts: [number, number][], fill: string) => {
  polys.push({ pts, fill })
  all.push(...pts)
}

const box = (x0: number, y0: number, z0: number, x1: number, y1: number, z1: number, color: string) => {
  poly([P(x0, y1, z0), P(x1, y1, z0), P(x1, y1, z1), P(x0, y1, z1)], mix(color, 0.86))
  poly([P(x1, y0, z0), P(x1, y1, z0), P(x1, y1, z1), P(x1, y0, z1)], mix(color, 0.68))
  poly([P(x0, y0, z1), P(x1, y0, z1), P(x1, y1, z1), P(x0, y1, z1)], mix(color, 1))
}

const shadow = [P(-14, -10, 0), P(128, -10, 0), P(128, 96, 0), P(-14, 96, 0)]
all.push(...shadow)

const TOP = 44
box(2, 2, 0, 8, 8, TOP, '#8a5a44')
box(100, 2, 0, 106, 8, TOP, '#8a5a44')
box(2, 72, 0, 8, 78, TOP, '#8a5a44')
box(100, 72, 0, 106, 78, TOP, '#8a5a44')
box(0, 0, TOP, 108, 80, TOP + 5, '#c47f5a')

const T = TOP + 5
box(8, 30, T, 24, 50, T + 5, '#3b3b4f')
box(8, 30, T + 5, 22, 50, T + 28, '#ff63c3')
box(10, 25, T + 10, 20, 30, T + 24, '#ff63c3')
box(10, 50, T + 10, 20, 55, T + 24, '#ff63c3')
box(9, 32, T + 28, 21, 48, T + 44, '#f1d3bd')
box(8, 31, T + 38, 22, 49, T + 47, '#2d2430')
box(7, 31, T + 28, 10, 49, T + 40, '#2d2430')
box(10, 36, T + 47, 18, 44, T + 53, '#2d2430')

box(28, 22, T, 66, 58, T + 2.5, '#9aa5b1')
box(66, 22, T + 1, 69, 58, T + 28, '#2c9a97')
box(69, 33, T + 11, 69.6, 47, T + 19, '#e6fffa')

box(84, 8, T, 96, 20, T + 8, '#8a8f98')
box(87, 11, T + 8, 93, 17, T + 16, '#48bb78')
box(83, 12, T + 12, 89, 16, T + 20, '#38a169')
box(91, 10, T + 14, 97, 14, T + 24, '#68d391')

box(78, 60, T, 88, 70, T + 9, '#f6f0e8')
box(88, 63, T + 3, 91, 67, T + 7, '#f6f0e8')

const xs = all.map((p) => p[0])
const ys = all.map((p) => p[1])
const pad = 12
const minX = Math.min(...xs) - pad
const minY = Math.min(...ys) - pad
const w = Math.max(...xs) + pad - minX
const h = Math.max(...ys) + pad - minY
const fmt = (pts: [number, number][]) => pts.map((p) => `${p[0].toFixed(1)},${p[1].toFixed(1)}`).join(' ')

const [ox, oy] = P(69.7, 45.5, T + 18.6)
const textMatrix = `matrix(${(C * S * 0.9).toFixed(3)} ${(-0.5 * S * 0.9).toFixed(3)} 0 ${(S * 0.9).toFixed(3)} ${ox.toFixed(1)} ${oy.toFixed(1)})`
---

<div class="hero-art" aria-hidden="true">
  <svg viewBox={`${minX.toFixed(0)} ${minY.toFixed(0)} ${w.toFixed(0)} ${h.toFixed(0)}`} xmlns="http://www.w3.org/2000/svg" role="img">
    <defs>
      <filter id="soft" x="-30%" y="-30%" width="160%" height="160%">
        <feGaussianBlur stdDeviation="9"></feGaussianBlur>
      </filter>
    </defs>
    <polygon points={fmt(shadow)} fill="#000" opacity="0.18" filter="url(#soft)"></polygon>
    {polys.map((p) => <polygon points={fmt(p.pts)} fill={p.fill} stroke={p.fill} stroke-width="0.6" stroke-linejoin="round"></polygon>)}
    <text transform={textMatrix} x="0" y="8" font-family="monospace" font-size="9" font-weight="700" fill="#2c9a97">ML</text>
  </svg>
</div>
