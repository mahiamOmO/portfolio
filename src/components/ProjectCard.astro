---
interface Props {
  slug: string
  title: string
  category: string
  description: string
  stack: string[]
  link: string
  liveLink?: string
  image?: string
  index?: number
}

const { slug, title, category, description, stack, link, liveLink, image, index = 0 } = Astro.props

const gradients = [
  'linear-gradient(135deg, #88ccca, #5aa5c8)',
  'linear-gradient(135deg, #ff63c3, #ffa36c)',
  'linear-gradient(135deg, #b794f4, #88ccca)',
  'linear-gradient(135deg, #f6e05e, #ff8a65)'
]
const initials = title
  .split(' ')
  .map((w) => w[0])
  .join('')
  .slice(0, 3)
  .toUpperCase()
---

<article class:list={['work-card', slug === 'mahia-portfolio' && 'portfolio-card']}>
  <a class="project-main-link" href={`/works/${slug}`} aria-label={`View details for ${title}`}>
    {
      image ? (
        <img class="thumb project-image" src={image} alt={`${title} project preview`} />
      ) : (
        <div class="thumb" style={`background: ${gradients[index % gradients.length]}`}>{initials}</div>
      )
    }
    <h3>{title}</h3>
    <p class="project-description">{description}</p>
  </a>
</article>
