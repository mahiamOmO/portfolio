---
interface Props {
  title: string
  category: string
  description: string
  stack: string[]
  link: string
  index?: number
}

const { title, category, description, stack, link, index = 0 } = Astro.props

const gradients = [
  'linear-gradient(135deg, #88ccca, #5aa5c8)',
  'linear-gradient(135deg, #ff63c3, #ffa36c)',
  'linear-gradient(135deg, #b794f4, #88ccca)',
  'linear-gradient(135deg, #f6e05e, #ff8a65)'
]
const initials = title
  .split(' ')
  .map((w) => w[0])
  .join('')
  .slice(0, 3)
  .toUpperCase()
---

<a href={link} target="_blank" rel="noopener noreferrer" style="color: inherit; text-decoration: none;">
  <article class="card work-card">
    <div class="thumb" style={`background: ${gradients[index % gradients.length]}`}>{initials}</div>
    <h3>{title}</h3>
    <p class="meta" style="margin-bottom: 0.5rem;">{category}</p>
    <p>{description}</p>
    <div class="tags">
      {stack.map((s) => <span class="tag">{s}</span>)}
    </div>
  </article>
</a>
