---
import Layout from '../layouts/Layout.astro'
import { posts } from '../data/profile'
---

<Layout title="Posts" description="Articles and notes by Mahia Akter Momo.">
  <header class="page-header">
    <h1>Popular Posts</h1>
  </header>

  <section class="posts-section" aria-labelledby="posts-heading">
    <h2 id="posts-heading" class="sr-only">All posts</h2>
    <div class="posts-grid">
      {
        posts.map((post) => (
          <article class="post-card">
            <a class="post-image-wrap" href={post.link} target="_blank" rel="noopener noreferrer" aria-label={`Read ${post.title}`}>
              <img src={post.image} alt="" class="post-image" loading="lazy" />
            </a>
            <h2>{post.title}</h2>
          </article>
        ))
      }
    </div>
  </section>
</Layout>
