---
import Layout from '../layouts/Layout.astro'
import { experience, education } from '../data/profile'
---

<Layout title="Experience" description="Professional experience and education of Mahia Akter Momo.">
  <h1 class="section-title" style="font-size: 1.6rem;">Experience</h1>

  <div class="stack">
    {
      experience.map((e) => (
        <article class="card">
          <div class="card-head">
            <h3>{e.title}</h3>
            <p class="meta">{e.period}</p>
          </div>
          <p class="meta">{e.company} · {e.location}</p>
          <ul>
            {e.points.map((p) => <li>{p}</li>)}
          </ul>
        </article>
      ))
    }
  </div>

  <section>
    <h2 class="section-title">Education</h2>
    <div class="stack">
      {
        education.map((e) => (
          <article class="card">
            <div class="card-head">
              <h3>{e.degree}</h3>
              <p class="meta">{e.period}</p>
            </div>
            <p class="meta">{e.school}</p>
          </article>
        ))
      }
    </div>
  </section>
</Layout>
